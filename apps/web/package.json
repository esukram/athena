    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.31.0",
    "mdast-util-from-markdown": "^2.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-flags-select": "^2.5.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
