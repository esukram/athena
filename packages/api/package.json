{
  "name": "@athena/api",
  "version": "0.10.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./speakable-text": {
      "types": "./dist/speakable-text.d.ts",
      "import": "./dist/speakable-text.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"*.{js,ts,json}\""
  },
  "dependencies": {
    "@athena/domain": "workspace:*",
    "@trpc/server": "^11.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@athena/eslint-config": "workspace:*",
    "@athena/typescript-config": "workspace:*",
    "eslint": "^9.39.4"
  }
}
